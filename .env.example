# LLM via Amazon Bedrock (sem API key — usa credencial AWS: IAM role na EC2 / profile local)
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Segredo do JWT (sessao). GERE UM FORTE: openssl rand -hex 32
JWT_SECRET=

# Bucket S3 para credenciais Baileys + midia (opcional). Vazio = disco local
# (data/auth/), sem cache de midia, nao sobrevive a troca de instancia EC2.
WA_AUTH_BUCKET=

# Web Push / VAPID (opcional). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Telegram bot (opcional). Cada usuario vincula o proprio chat id no web app.
TELEGRAM_BOT_TOKEN=

# Web app
PORT=3000

# Comportamento
IGNORE_GROUPS=true
CONTEXT_WINDOW=15
PERSONA=Responda de forma educada, direta e amigavel, em portugues do Brasil, como se fosse eu.
